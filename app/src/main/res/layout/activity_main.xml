<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drug-Likeness Checker"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etDrugName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Drug Name"
            android:inputType="text"/>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search Drug"/>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan Medicine"/>

        <ImageView
            android:id="@+id/ivStructure"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="Molecular Structure"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/tvFormula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Molecular Formula:"
            android:textSize="16sp"
            android:padding="5dp"/>

        <TextView
            android:id="@+id/tvIUPAC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IUPAC Name:"
            android:textSize="16sp"
            android:padding="5dp"/>

        <TextView
            android:id="@+id/tvSMILES"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMILES:"
            android:textSize="16sp"
            android:padding="5dp"/>

        <TextView
            android:id="@+id/tvProperties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drug Properties:"
            android:textSize="16sp"
            android:padding="5dp"/>

        <TextView
            android:id="@+id/tvADMET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADMET Results:"
            android:textSize="16sp"
            android:padding="5dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Drug"/>

    </LinearLayout>

</ScrollView>